# Public-source allow-list: new top-level content is private until reviewed.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/LICENSE
!/pyproject.toml
!/README.md
!/README.zh-CN.md
!/AGENTS.md
!/.github/
!/src/
!/tests/
!/scripts/
!/configs/
!/docs/

# Historical notes, source media, device logs and generated reports stay local.
/docs/*
!/docs/README.md
!/docs/12-项目需求梳理与实现方案总纲.md
!/docs/13-双库数据契约与Skill执行规范.md
!/docs/14-实施计划与验收矩阵.md
!/docs/15-项目路径结构与开源维护规范.md
!/docs/16-定稿角色SA02与JK03使用约束.md
!/docs/17-S02场景定稿与四张构图母版规范.md
!/docs/18-开源发布与持续同步规范.md
!/docs/19-BM01真实角色替换与JK03退役约束.md
!/docs/en/
!/docs/images/
!/docs/CONTRIBUTING.md
!/docs/SECURITY.md
!/docs/CHANGELOG.md
!/docs/GOVERNANCE.md
!/docs/THIRD_PARTY_NOTICES.md
!/docs/templates/
!/docs/evidence/
!/docs/schemas/
!/docs/examples/
/docs/examples/*
!/docs/examples/dual-library-record.example.json

# Local configuration is never a distributable example.
/configs/*
!/configs/project.example.toml

# Python/build/editor caches, in any allowed source directory.
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
build/
dist/
coverage.xml
.coverage*
htmlcov/
*.log
*.tmp
*.swp
.DS_Store
Thumbs.db

# Defense in depth: media/weights/archives/credentials must not enter source.
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.wav
*.mp3
*.flac
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
*.gguf
*.npz
*.npy
*.fbx
*.bvh
*.glb
*.zip
*.7z
*.tar
*.gz
*.pem
*.key
*.p12
*.pfx
.env
.env.*
!*.env.example
*credentials*.json
*secrets*.json
**/device.json

# User-requested README character illustrations: exact files only, not raw photos.
/docs/images/*
!/docs/images/characters/
/docs/images/characters/*
!/docs/images/characters/manifest.json
!/docs/images/characters/sa02-front-v1.png
!/docs/images/characters/sa02-four-view-candidate-v1.png
!/docs/images/characters/sa02-s02-knee-v1.png
!/docs/images/characters/sa02-s02-full-v1.png
!/docs/images/characters/bm01-front-v1.png
!/docs/images/characters/bm01-four-view-v1.png
!/docs/images/characters/bm01-s02-knee-v1.png
!/docs/images/characters/bm01-s02-full-v1.png
