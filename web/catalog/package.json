{
  "name": "motion-catalog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs --target root",
    "build:pages": "node scripts/build.mjs --target pages",
    "build:local": "node scripts/build.mjs --target local",
    "preview": "node scripts/serve.mjs --target root",
    "preview:pages": "node scripts/serve.mjs --target pages",
    "preview:local": "node scripts/serve.mjs --target local",
    "check": "tsc --noEmit",
    "test": "node --test tests/core.test.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.65.1",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
