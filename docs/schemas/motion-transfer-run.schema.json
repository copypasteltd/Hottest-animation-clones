{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Whole-video motion-transfer attempt",
  "description": "One project-local attempt for one whole source video and one target variant. Completed means the corresponding MP4 was retrieved.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "run_id",
    "item_id",
    "variant",
    "input_scope",
    "source",
    "decision",
    "target",
    "workflow",
    "execution",
    "output"
  ],
  "properties": {
    "schema_version": {"const":"motion-transfer-run/2.1"},
    "record_kind": {"enum":["illustrative_example","run"]},
    "run_id": {"type":"string","minLength":1},
    "item_id": {"type":"string","minLength":1},
    "variant": {"enum":["SA02","BM01"]},
    "input_scope": {"const":"whole_video"},
    "source": {"$ref":"#/$defs/source"},
    "decision": {"$ref":"#/$defs/decision"},
    "target": {"anyOf":[{"$ref":"#/$defs/target"},{"type":"null"}]},
    "workflow": {"anyOf":[{"$ref":"#/$defs/workflow"},{"type":"null"}]},
    "execution": {"$ref":"#/$defs/execution"},
    "output": {"anyOf":[{"$ref":"#/$defs/output"},{"type":"null"}]}
  },
  "allOf": [
    {
      "if": {"properties":{"execution":{"properties":{"status":{"enum":["queued","running","completed"]}}}}},
      "then": {
        "properties": {
          "source": {"properties":{"download_status":{"const":"downloaded"}}},
          "decision": {"properties":{"status":{"const":"decided"}}},
          "target": {"type":"object"},
          "workflow": {"type":"object"},
          "execution": {
            "properties": {
              "receipt_id": {"type":"string","minLength":1},
              "inputs_manifest_path": {"$ref":"#/$defs/relativePath"}
            }
          }
        }
      }
    },
    {
      "if": {"properties":{"execution":{"properties":{"status":{"const":"completed"}}}}},
      "then": {"properties":{"output":{"type":"object"}}},
      "else": {"properties":{"output":{"type":"null"}}}
    },
    {
      "if": {"properties":{"record_kind":{"const":"illustrative_example"}}},
      "then": {
        "properties": {
          "source": {
            "properties": {
              "download_status": {"const":"not_run"},
              "download_method": {"type":"null"},
              "sidecar_path": {"type":"null"}
            }
          },
          "decision": {"properties":{"status":{"const":"planned"},"visible_parts":{"maxItems":0}}},
          "target": {"type":"null"},
          "workflow": {"type":"null"},
          "execution": {
            "properties": {
              "status": {"const":"planned"},
              "receipt_id": {"type":"null"},
              "inputs_manifest_path": {"type":"null"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "relativePath": {
      "type": "string",
      "pattern": "^(?!(?:[^/]+/)*\\.{1,2}(?:/|$))[^/\\\\:\\u0000-\\u001F]+(?:/[^/\\\\:\\u0000-\\u001F]+)*(?![\\s\\S])"
    },
    "sha256": {"type":"string","pattern":"^[a-f0-9]{64}(?![\\s\\S])"},
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path","sha256","bytes","duration_ms","width","height","frame_rate","video_codec","audio_codec"],
      "properties": {
        "path": {"$ref":"#/$defs/relativePath"},
        "sha256": {"$ref":"#/$defs/sha256"},
        "bytes": {"type":"integer","minimum":1},
        "duration_ms": {"type":"integer","minimum":1},
        "width": {"type":"integer","minimum":1},
        "height": {"type":"integer","minimum":1},
        "frame_rate": {"type":"string","pattern":"^[1-9][0-9]*/[1-9][0-9]*(?![\\s\\S])"},
        "video_codec": {"type":"string","minLength":1},
        "audio_codec": {"anyOf":[{"type":"string","minLength":1},{"type":"null"}]}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform","source_id","download_status","download_method","media","sidecar_path"],
      "properties": {
        "platform": {"enum":["bilibili","x","douyin"]},
        "source_id": {"type":"string","minLength":1},
        "download_status": {"enum":["not_run","downloaded","blocked","failed","unknown"]},
        "download_method": {"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},
        "media": {"anyOf":[{"$ref":"#/$defs/media"},{"type":"null"}]},
        "sidecar_path": {"anyOf":[{"$ref":"#/$defs/relativePath"},{"type":"null"}]}
      },
      "if": {"properties":{"download_status":{"const":"downloaded"}}},
      "then": {
        "properties": {
          "download_method": {"type":"string","minLength":1},
          "sidecar_path": {"$ref":"#/$defs/relativePath"},
          "media": {"type":"object"}
        }
      },
      "else": {"properties":{"media":{"type":"null"}}}
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status","framing","performers","performer_count","posture","visible_parts","reason","limits"],
      "properties": {
        "status": {"enum":["planned","undetermined","decided"]},
        "framing": {"anyOf":[{"enum":["half_body","full_body"]},{"type":"null"}]},
        "performers": {"anyOf":[{"enum":["single","multiple"]},{"type":"null"}]},
        "performer_count": {"anyOf":[{"type":"integer","minimum":1},{"type":"null"}]},
        "posture": {"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},
        "visible_parts": {"type":"array","items":{"type":"string","minLength":1}},
        "reason": {"type":"string","minLength":1},
        "limits": {"type":"array","items":{"type":"string","minLength":1}}
      },
      "allOf": [
        {
          "if": {"properties":{"status":{"const":"decided"}}},
          "then": {
            "properties": {
              "framing": {"type":"string"},
              "performers": {"type":"string"},
              "performer_count": {"type":"integer","minimum":1},
              "posture": {"type":"string","minLength":1}
            }
          }
        },
        {
          "if": {"properties":{"performers":{"const":"single"}}},
          "then": {"properties":{"performer_count":{"const":1}}}
        },
        {
          "if": {"properties":{"performers":{"const":"multiple"}}},
          "then": {"properties":{"performer_count":{"type":"integer","minimum":2}}}
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_id","scene_revision","images","performer_mapping"],
      "properties": {
        "scene_id": {"type":"string","minLength":1},
        "scene_revision": {"type":"integer","minimum":1},
        "images": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/targetImage"}},
        "performer_mapping": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["performer_ref","character_id","image_id"],
            "properties": {
              "performer_ref": {"type":"string","minLength":1},
              "character_id": {"type":"string","minLength":1},
              "image_id": {"type":"string","minLength":1}
            }
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_path",
        "original_sha256",
        "execution_graph",
        "active_branch",
        "input_mapping",
        "output_mapping"
      ],
      "properties": {
        "original_path": {
          "$ref": "#/$defs/relativePath",
          "pattern": "^user/default/workflows/社区精选H3_人物与场景替换_实验/.+\\.json(?![\\s\\S])"
        },
        "original_sha256": {"$ref":"#/$defs/sha256"},
        "execution_graph": {"$ref":"#/$defs/executionGraph"},
        "active_branch": {"type":"string","minLength":1},
        "input_mapping": {
          "type": "object",
          "additionalProperties": false,
          "required": ["motion_video","target_images","scene","audio"],
          "properties": {
            "motion_video": {"type":"string","minLength":1},
            "target_images": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
            "scene": {"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},
            "audio": {"anyOf":[{"type":"string","minLength":1},{"type":"null"}]}
          }
        },
        "output_mapping": {"type":"string","minLength":1}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_id","status","reason","receipt_id","inputs_manifest_path"],
      "properties": {
        "attempt_id": {"type":"string","minLength":1},
        "status": {"enum":["planned","blocked","queued","running","unknown","failed","completed","cancelled"]},
        "reason": {"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},
        "receipt_id": {"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},
        "inputs_manifest_path": {"anyOf":[{"$ref":"#/$defs/relativePath"},{"type":"null"}]}
      },
      "if": {"properties":{"status":{"const":"cancelled"}}},
      "then": {"properties":{"reason":{"$ref":"#/$defs/text"}}}
    },
    "text": {"type":"string","minLength":1},
    "targetImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_id","revision","path","sha256"],
      "properties": {
        "image_id": {"type":"string","minLength":1},
        "revision": {"type":"integer","minimum":1},
        "path": {"$ref":"#/$defs/relativePath"},
        "sha256": {"$ref":"#/$defs/sha256"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path","audio_treatment","warnings"],
      "properties": {
        "path": {"$ref":"#/$defs/relativePath","pattern":"^outputs/.+\\.mp4(?![\\s\\S])"},
        "audio_treatment": {"enum":["source","silent","generated","mixed","unknown"]},
        "warnings": {"type":"array","items":{"$ref":"#/$defs/text"}}
      }
    },
    "executionGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind","path_base","path","sha256"],
      "properties": {
        "kind": {"enum":["original","copy","api"]},
        "path_base": {"enum":["project","remote_comfyui"]},
        "path": {"$ref":"#/$defs/relativePath"},
        "sha256": {"$ref":"#/$defs/sha256"}
      }
    }
  }
}
